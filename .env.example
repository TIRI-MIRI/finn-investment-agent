# FINN Investment Agent - Environment Configuration
# Never commit .env to version control. This file is an example only.

# Demo mode flag - set to "true" to run without API credentials
DEMO_MODE=true

# If connecting to real APIs (optional, only if you have credentials)
# NSE_API_KEY=your_nse_here
# BSE_API_KEY=your_bse_here
# YFINANCE_AVAILABLE=true  # yfinance is bundled, no key needed

# Optional: OpenAI keys if you want LLM features (never commit these!)
# OPENAI_API_KEY=sk-...

# Application settings
APP_NAME="FINN - Financial Investment Intelligence"
APP_ENV=demo
DEBUG=true